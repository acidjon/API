<div class="block shadow w-auto rounded-lg p-2 m-1">
    {{#if name}}
    <h1 class="text-center w-auto p-2 m-2 font-semibold text-2xl">Hola <b>{{name}}</b></h1>
    {{/if}}
    <fieldset class="border shadow w-auto h-full justify-content bg-white rounded-md flex text-center">
        <div class="min-h-screen bg-gray-100 p-5 w-full rounded text-center">
            <div class=" gap-5 h-auto text-center">
                <main id="main-panel" class="col-span-10 bg-white rounded-xl shadow-lg p-6">
                    <h2 class="text-2xl font-bold text-blue-700 mb-6">Lista de Tareas</h2>

                    <div class="flex justify-center gap-4 pt-6">
                        <button onclick="toogleForm('add-task')"
                            class="bg-blue-600 hover:bg-blue-700 text-white px-6 py-2 rounded-lg">
                            Agregar tarea
                        </button>
                    </div>

                    {{#if mess}}
                    <p class="text-{{color}}-100 text-center">{{mess}}</p>
                    {{/if}}

                    <hr class="my-6">

                    <h3 class="text-xl font-bold text-blue-700 mb-4 p-2">Tareas registradas</h3>

                    <div class="overflow-x-auto rounded-lg shadow">
                        <table class="w-auto bg-white border border-gray-200 w-full">
                            <thead class="bg-blue-600 text-white">
                                <tr>
                                    <th class="px-4 py-3 text-center">#</th>
                                    <th class="px-4 py-3 text-center">Fecha</th>
                                    <th class="px-4 py-3 text-center">Tarea</th>
                                    <th class="px-4 py-3 text-center">Estado</th>
                                    <th class="px-4 py-3 text-center">Editar</th>
                                    <th class="px-4 py-3 text-center">Eliminar</th>
                                </tr>

                            </thead>

                            <tbody>

                                {{#each orders}}

                                <tr class="border-b bg-{{color}}-200 border hover:bg-gray-100">

                                    <td class="p-1 text-xs bg-{{color}}-400 text-center">
                                        {{id}}
                                    </td>

                                    <td class="p-1 text-xs text-center">
                                        {{date_task}}
                                    </td>

                                    <td class="p-1 text-xs text-center">
                                        {{task}}
                                    </td>

                                    <td class="p-1 text-xs text-center">
                                        {{status}}
                                    </td>

                                    <td class="flex p-3 text-center">
                                        <select id="select-task-{{id}}" onchange="cambiarEstado('{{id}}', this.value)"
                                            class="p-1 rounded font-semibold text-center border cursor-pointer {{colorBg}} {{colorText}}">
                                            <option value="Pendiente">Pendiente</option>
                                            <option value="Listo">Listo</option>
                                        </select>
                                        <script>
                                            document.getElementById('select-task-{{id}}').value = "{{status}}";
                                        </script>
                                    </td>

                                    <td flex p-3 text-center>
                                        <button onclick="deletetask('{{id}}')"
                                            class="bg-red-100 hover:bg-red-300 text-white p-1 rounded-full ml-2 text-xs">
                                            🗑️
                                        </button>
                                    </td>

                                </tr>

                                {{/each}}

                            </tbody>

                        </table>

                    </div>
                </main>
            </div>
        </div>
    </fieldset>
</div>

{{!-- toogle --}}

<div id="add-task"
    class="toogle-form hidden fixed inset-0 overflow-y-auto max-w-2xl mx-auto p-1 bg-gray-100 rounded shadow mt-8 height-auto">

    <div class="flex pt-4">
        <h2 id="task-tittle" class="text-center w-1/2 font-semibold text-blue-600">Agregar tarea</h2>
        <button onclick="toogleForm('add-task')"
            class="bg-red-400 text-white w-1/8 justify-end border-2 shadow py-1 px-4 rounded ml-auto flex hover:bg-red-500">X</button>
    </div>

    <form id="form-task" action="/addtask" method="post" class="space-y-4 bg-gray-100 p-2 rounded h-full">

        <input type="hidden" id="id" name="id">
        {{!-- <input type="hidden" id="date_task" name="date_task" value="{{date_task}}"> --}}

        <div>
            <label>Tarea</label>
            <textarea id="task" name="task" rows="5" class="w-full border rounded-lg p-2"></textarea>
        </div>

        <div class="grid grid-cols-3 gap-4">
            <div>
                <label>Estado</label>
                <select id="status" name="status" class="w-full border rounded-lg p-2">
                    <option>Pendiente</option>
                    <option>Listo</option>
                </select>
            </div>
        </div>

        <div class="flex justify-center mt-4 pb-4">
            <button id="btn-add" type="submit"
                class="text-center w-1/3 bg-blue-600 text-white p-2 rounded hover:bg-blue-700 hover:shadow-lg">
                Agregar tarea
            </button>
        </div>
    </form>
</div>


<script src="public/js/ui.js"></script>