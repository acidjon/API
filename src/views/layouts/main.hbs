<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>tasks</title>
    <link rel="stylesheet" 
    href="https://cdnjs.cloudflare.com/ajax/libs/tailwindcss/2.0.1/tailwind.min.css">
</head>
<body class="bg-gray-200 w-full mx-auto">
    <nav class="flex py-2 bg-green-500 text-white px-2 shadow-lg rounded-md">
        <div class="w-1/2 px-4 mr-auto">
            <a class="px-4 text-2xl font-semibold bg-green-600 rounded-md" href="/home">KEV</a>
        </div>
        <ul class="w-1/2 px-5 ml-auto flex justify-end pt-1">
           {{#if name}}
                <p>{{name}}</p>
             <a class="border shadow hover:bg-white hover:text-green-700 rounded-md mx-4 px-4" href="/logout">Salir</a>
             {{else}}
             <li class="nav-item px-4">
             <a href="/login" class="nav-link font-semibold border-2 border-white hover:bg-white hover:text-green-700 py-1 px-2 rounded-md">Iniciar sesión</a>
             </li>
             <li class="nav-item px-4">
             <a href="/register" class="nav-link font-semibold hover:bg-green-700 py-1 px-4 rounded-md">Registrar</a>
             </li>
           {{/if}} 
        </ul>
    </nav>

    {{{body}}}
    
    <script src="/js/ui.js"></script>
</body>
</html>