<h1 class="text-center text-2xl font-bold">Iniciar sesión</h1>

<div class="block mx-auto my-12 p-8 bg-white w-1/3 border border-gray-200 rounded-lg shadow-lg justify-center">
    <form action="" method="POST" class="mt-4">
        <input name="email" type="text" class="border border-gray-200 shadow w-full text-lg placeholder-gray-500 p-2 m-2 bg-gray-200 focus:bg-white" placeholder="correo@email.com" required/>
        <input name="password" type="password" class="border border-gray-200 shadow w-full text-lg placeholder-gray-500 p-2 m-2 bg-gray-200 focus:bg-white" placeholder="****" required/>
        <button type="submit" class="rounded-md shadow bg-green-500 w-1/3 text-lg text-white font-semibold p-1 my-3 hover:bg-green-600 focus:bg-green-700 justify-end" >Enviar</button>

        {{#if error}}
            <p class="text-red-600">*. {{error}} .*</p>
        {{/if}}
    </form>
</div>